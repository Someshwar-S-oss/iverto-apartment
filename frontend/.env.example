# -----------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# -----------------------------------------------------------------------------

# [Required for Production / Vercel]
# Full URL to your deployed backend API (e.g., https://iverto-backend.onrender.com)
# All REST API endpoints (/api/v1/...) are resolved relative to this URL.
VITE_API_URL=https://your-backend-api.onrender.com

# [Optional]
# Realtime WebSocket / Socket.IO server URL.
# If omitted, it automatically defaults to VITE_API_URL.
VITE_WS_URL=https://your-backend-api.onrender.com

# [Local Development Only]
# Used by Vite local dev server proxy (vite.config.ts) when running `npm run dev`
VITE_BACKEND_URL=http://localhost:8031

