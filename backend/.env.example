NODE_ENV=development
PORT=8031
# Runtime app connection. MUST be a role WITHOUT the BYPASSRLS attribute — Neon's default
# provisioned roles (the *_owner role, neon_service, cloud_admin) all have BYPASSRLS set,
# which silently disables every RLS policy for that role regardless of FORCE ROW LEVEL
# SECURITY. Create a dedicated low-privilege role first: see scripts/create-app-role.sql.
DATABASE_URL=postgres://iverto_app:password@ep-sample.us-east-2.aws.neon.tech/iverto?sslmode=require
# Migrations only (DDL). Safe to use the table-owning role here since migrations don't
# rely on RLS being enforced against themselves. drizzle.config.ts prefers this over
# DATABASE_URL when both are set.
DIRECT_DATABASE_URL=postgres://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/iverto?sslmode=require
REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=iverto:gate:
# Required when NODE_ENV=production — the app refuses to start without it rather than
# silently falling back to the insecure development default.
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Comma-separated list of allowed browser origins, e.g.
# "https://app.iverto.com,https://admin.iverto.com". Defaults to '*' if unset.
CORS_ORIGINS=
M50_WS_PATH=/m50
M50_CLOUD_ID=M50_CLOUD_DEV_01
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
